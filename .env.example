# Public site origin, used for canonical URLs and CAPI event_source_url
NEXT_PUBLIC_SITE_URL="https://jana.vercel.app"

# --- Meta tracking ---
# Pixel ID (public — it ships to the browser)
NEXT_PUBLIC_FB_PIXEL_ID=""
# Conversions API access token (SECRET — server only, never prefix with NEXT_PUBLIC_)
FB_CAPI_ACCESS_TOKEN=""
# Optional: shows events in Events Manager > Test Events instead of counting them live
FB_TEST_EVENT_CODE=""

# --- Video (Cloudflare Stream) ---
# The customer code from your Stream embed URLs: the `customer-xxxxxxxx` part
# of https://customer-xxxxxxxx.cloudflarestream.com/<video-uid>/iframe
# Public (it ships to the browser). Per-video UIDs go in content/properties.ts.
NEXT_PUBLIC_CF_STREAM_CUSTOMER_CODE=""

# --- Lead delivery ---
# Optional webhook that receives every lead as JSON (CRM, Zapier, Make, n8n, Sheet)
LEAD_WEBHOOK_URL=""
