# Public site origin, used for canonical URLs and CAPI event_source_url
NEXT_PUBLIC_SITE_URL="https://jana.vercel.app"

# --- Meta tracking ---
# Pixel ID (public — it ships to the browser)
NEXT_PUBLIC_FB_PIXEL_ID=""
# Conversions API access token (SECRET — server only, never prefix with NEXT_PUBLIC_)
FB_CAPI_ACCESS_TOKEN=""
# Optional: shows events in Events Manager > Test Events instead of counting them live
FB_TEST_EVENT_CODE=""

# --- Video ---
# Public base URL of the R2 bucket, NO trailing slash.
# Either the r2.dev URL (dev only) or your custom domain:
#   https://pub-xxxxxxxxxxxx.r2.dev        <- testing
#   https://media.your-domain.com          <- production
# Films resolve to <base>/<slug>.mp4 and posters to <base>/<slug>.jpg
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=""

# Only if you move to Cloudflare Stream instead of R2: the `customer-xxxxxxxx`
# part of https://customer-xxxxxxxx.cloudflarestream.com/<uid>/iframe
NEXT_PUBLIC_CF_STREAM_CUSTOMER_CODE=""

# --- Lead delivery ---
# Optional webhook that receives every lead as JSON (CRM, Zapier, Make, n8n, Sheet)
LEAD_WEBHOOK_URL=""
